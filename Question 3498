class Solution {
public:
    int reverseDegree(string s) {
        int sum=0;
        int b=1;
        int c;
        int d=0;
        for(int i=0;i<s.size();i++){
            char a=s[i];
            c=123-a;
            d=c*b;
            
            sum+=d;
            b++;
        }

        
    return sum;}
};
