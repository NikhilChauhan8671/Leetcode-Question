class Solution {
public:
    int maxArea(vector<int>& height) {
        int i=0;
        int j=height.size()-1;
        int maxx=INT_MIN;
        while(i<j){
            int water=min(height[i],height[j])*(j-i);
            maxx=max(maxx,water);
            if(height[i]<height[j]){
                i++;
            }
            else(j--);
        }
        
    return maxx;}
};
