class Solution {
public:
    
        bool check(string &s,int st,int e){
            if(st>=e){
                return true;
            }
            if(s[st]!=s[e]){
                return false;}
                return check(s,st+1,e-1);
            
        }
        bool isvalid(string &s,int st,int e){
            if(st>=e){
                return true;
            }
            if(s[st]==s[e]){
                return isvalid(s,st+1,e-1);
            }
            else{
                return check(s,st+1,e)||check(s,st,e-1);
            }
        }
        bool validPalindrome(string s) {
            return isvalid(s, 0, s.size() - 1);
        }
    
};
