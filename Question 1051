class Solution {
public:
    int heightChecker(vector<int>& heights) {
        int n=heights.size();
        vector<int>temp(n);
        int count=0;
        for(int i=0;i<heights.size();i++){
            temp[i]=heights[i];
        }
        sort(temp.begin(),temp.end());
        for(int i =0;i<heights.size();i++){
            if(temp[i]!=heights[i]){
                count++;
            }
        }
    return count;}
};
