class Solution {
public:
    int findMin(vector<int>& nums) {
        int low=0;
        int high=nums.size()-1;
        int minn=INT_MAX;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[low]==nums[mid]&&nums[mid]==nums[high]){
                minn=min(minn,nums[mid]);
                high--;
                low++;
                continue;
            }
            if(nums[low]<=nums[mid]){
                minn=min(minn,nums[low]);
                low=mid+1;
            }
            else{
                minn=min(minn,nums[mid]);
                high=high-1;
            }
        }
        return minn;
    }
};
