class Solution {
public:
    int addDigits(int num) {
        
        int sum=0;
        
        while(num){
            int digit=num%10;
            sum=sum+digit;
            num/=10;}
            if(to_string(sum).length()!=1){
                
                return addDigits(sum);
            }
            else{
                return sum;
            }
    return 0;}
};
