class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        vector<int>temp;
        for(int i=0;i<nums.size();i++){
            temp.insert(temp.begin()+i,nums[i]);
        }
         for(int i=0;i<nums.size();i++){
            temp.insert(temp.begin()+nums.size()+i,nums[i]);
        }
        
    return temp ;}
};
