class Solution {
public:
    int findMiddleIndex(vector<int>& nums) {
        
        int sum=0;
        int prefix=0;
        for(auto x:nums){
            sum+=x;
        }
        for(int i=0;i<nums.size();i++){
            if(prefix==(sum-prefix-nums[i])){
                return i;}
                prefix+=nums[i];
            
        }
   return -1; }
};
