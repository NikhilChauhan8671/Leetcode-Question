class Solution {
public:
    int maxAbsoluteSum(vector<int>& nums) {
        int n=nums.size();
        int sum=0;
        int maxi=INT_MIN;
        int maxim=INT_MAX;
        int sum2=0;
        for(int i=0;i<n;i++){
            sum=(sum+(nums[i]));
            maxi=max(maxi,sum);
            if(sum<0){
                sum=0;
            } 
            
        }
        for(int i=0;i<n;i++){
            sum2=(sum2+(nums[i]));
            maxim=(min(maxim,sum2));
            if(sum2>0){
                sum2=0;
            }}
        return max(maxi,abs(maxim));
        
    }
};
