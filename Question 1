class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        map<int,int> mpp;
        for(int i=0;i<nums.size();i++){
            int get=target-nums[i];
           if (mpp.find(get) != mpp.end()){
            return{i,mpp[get]};

           }
           mpp[nums[i]]=i;
            
        }
        
        return {};
    }  
};
