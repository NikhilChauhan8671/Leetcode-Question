class Solution {
public:
    int thirdMax(vector<int>& nums) {
        set<int>ans;
        int n=nums.size();
        for(int i=0;i<n;i++){
            ans.insert(nums[i]);
        }
        if(ans.size() < 3)
        { return *ans.rbegin(); }
        auto it = ans.rbegin();
        advance(it, 2);
        return *it;
    }
};
