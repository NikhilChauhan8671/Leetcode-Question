class Solution {
public:
    void sortColors(vector<int>& nums) {
        int zeroes=0;
        int ones=0;
        int twos=0;
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]==0){
                zeroes++;
            }
            else if(nums[i]==1){
                ones++;
            }
            else
                twos++;
        }
        for(int i=0;i<zeroes;i++){
            nums[i]=0;
        }
        for(int i=zeroes;i<zeroes+ones;i++){
            nums[i]=1;
        }
        for(int i=ones+zeroes;i<n;i++){
            nums[i]=2;
        }
    }
};
