class Solution {
public:
    bool isSumEqual(string firstWord, string secondWord, string targetWord) {
        int fsum=0;
        int ssum=0;
        int tsum=0;
        for(int i=0;i<firstWord.size();i++){
            fsum=fsum*10+firstWord[i]-97;
        }
        for(int i=0;i<secondWord.size();i++){
            ssum=ssum*10+secondWord[i]-97;
        }
        for(int i=0;i<targetWord.size();i++){
            tsum=tsum*10+targetWord[i]-97;

        }
        if(fsum+ssum==tsum){
            return true;
        }
        
    return false;}
};
