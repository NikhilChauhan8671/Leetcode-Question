class Solution {
public:
    int mySqrt(int x) {
        if(x==1||x==0){return x;}
        int i=0;
        int j=x;
        int ans=0;
        while(i<=j){
            int mid=i+(j-i)/2;
            if((long long)mid*mid==x){
                return mid;
            }
            else if((long long)mid*mid<x){
                ans=mid;
                i=mid+1;
            }
            else{//ans=mid;
                j=mid-1;}
        }
        
    return ans;}
};
