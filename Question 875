class Solution {
public:

    bool isPossible(vector<int>& piles, int h,int k) {
        long long hours=0;
        for(int i=0;i<piles.size();i++){
            hours+=(piles[i]+k-1)/k;
        }
        return hours<=h;
        }
    int minEatingSpeed(vector<int>& a, int h) {
       int k=-1;
       int low=1;
       int high=*max_element(a.begin(),a.end());
       while(low<=high){
        int mid=low+(high-low)/2;
        if(isPossible(a,h,mid))
            {k=mid;
            high=mid-1;}
        else{
            low=mid+1;

            }}
        
        return k;
       
    
}};
