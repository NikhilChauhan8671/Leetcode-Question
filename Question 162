class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        
        int max=nums[0];
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]>max){
                max=nums[i];
            }
        }
        for(int i=0;i<n;i++){
            if(nums[i]==max){
                return i;
            }
        }
     return 0;   
    
}};
